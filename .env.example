# SynthOS Admin — environment configuration.
#
#   cp .env.example .env      then fill in only what you actually use.
#
# EVERY variable here is OPTIONAL. Core platform startup (auth, SQLite, session,
# Ed25519 receipt signing) genuinely requires zero credentials — SQLite and the
# signing keypair are both self-provisioning. That is asserted by
# test/env-readiness.test.ts, not just claimed. Each variable below gates exactly
# one optional integration.
#
# This file is kept in lockstep with lib/env-readiness.ts by
# test/env-spec-completeness.test.ts: a variable the server reads but that is
# missing here fails the build, and so does an inert variable offered here that
# nothing reads. An inert knob reads as a working one.
#
# Never commit a filled-in .env. Anything marked SECRET below is a credential.

# --- Knowledge Vault ---
# SYNTHOS_VAULT_PATH
#   Absolute path to your real Markdown/Obsidian vault, e.g. /Users/you/vault
#   (a leading ~/ is expanded). SynthOS writes knowledge notes ONLY under a
#   bounded SynthOS/ subdirectory of it, and never renames, moves, normalises or
#   deletes anything already there. Leave empty to use the repo-local ./vault
#   development fallback — which is NOT an Obsidian integration, and is reported
#   as NOT_CONFIGURED at startup so it cannot be mistaken for one.
SYNTHOS_VAULT_PATH=""

# --- Provider Router (Gemini) ---
# GEMINI_API_KEY (SECRET)
#   /api/generate, model-backed skills, graph/task execution
GEMINI_API_KEY=""

# --- Provider Router (OpenRouter) ---
# OPENROUTER_API_KEY (SECRET)
#   Recognized but UNSUPPORTED — no execution mapping wired (see lib/model-router.ts)
OPENROUTER_API_KEY=""

# --- Hermes Runtime Adapter ---
# HERMES_ADAPTER_BASE_URL
#   hermesAdapter.health()/execute() real network calls
HERMES_ADAPTER_BASE_URL=""

# HERMES_ADAPTER_TOKEN (SECRET)
#   Authenticated calls to the Hermes adapter base URL
HERMES_ADAPTER_TOKEN=""

# HERMES_LOCAL_ENABLED
#   Must be exactly "true" for ANY dispatch to the local Hermes CLI (capability hermes.execute).
#   Unset refuses execution even when the CLI is installed and answering, because a run spends
#   real ChatGPT/Codex subscription quota. A reachable binary is not authorization.
HERMES_LOCAL_ENABLED=""

# HERMES_CLI_PATH
#   Overrides the path to the hermes executable. Unset resolves ~/.local/bin/hermes.
HERMES_CLI_PATH=""

# --- Windmill External Execution ---
# WINDMILL_BASE_URL
#   Any real Windmill API call
WINDMILL_BASE_URL=""

# WINDMILL_TOKEN (SECRET)
#   Authenticated Windmill calls (GET /api/users/whoami, job submit/status/result/cancel)
WINDMILL_TOKEN=""

# WINDMILL_WORKSPACE
#   Every /api/w/{workspace}/... Windmill endpoint
WINDMILL_WORKSPACE=""

# --- Antigravity Runtime ---
# ANTIGRAVITY_ENABLED
#   Must be exactly "true" for ANY outward Antigravity execution. Unset or anything else
#   disables submission entirely, even when a credential is present. This is a real kill
#   switch enforced in code, not a note.
ANTIGRAVITY_ENABLED=""
# SYNTHOS_AUTONOMY_LEVEL — optional override. Normally set by a platform admin in
# Master Admin → Antigravity & Autonomy (MANUAL / INTERNAL_AUTOMATION / APPROVAL_GATED_EXTERNAL;
# default INTERNAL_AUTOMATION). When set here it wins and the Admin shows it as locked.
SYNTHOS_AUTONOMY_LEVEL=""

# ANTIGRAVITY_API_KEY (SECRET)
#   Optional dedicated credential for the managed Antigravity agent API. Unset falls back to
#   the resolved Gemini credential — same Google endpoint, same key type. Set it only to bill
#   or scope agent execution separately from ordinary generation.
ANTIGRAVITY_API_KEY=""

# ANTIGRAVITY_AGENT
#   Overrides the managed agent id. Unset uses lib/antigravity-client.ts
#   ANTIGRAVITY_DEFAULT_AGENT.
ANTIGRAVITY_AGENT=""

# ANTIGRAVITY_BASE_URL
#   Overrides the managed agent API base URL (an enterprise gateway, or a test double).
#   Unset uses https://generativelanguage.googleapis.com/v1beta.
ANTIGRAVITY_BASE_URL=""

# --- MCP Connectivity ---
# MCP_ALLOW_LOCAL_ENDPOINTS
#   Local-development escape hatch for the SSRF guard — must stay unset in production
MCP_ALLOW_LOCAL_ENDPOINTS=""

# MCP_CREDENTIAL_ENCRYPTION_KEY (SECRET)
#   Storing an MCP server bearer-token credential at rest
MCP_CREDENTIAL_ENCRYPTION_KEY=""

# --- Apollo Voice (TTS) ---
# FISH_AUDIO_API_KEY (SECRET)
#   Fish Audio TTS + barge-in (interrupt())
FISH_AUDIO_API_KEY=""

# FISH_AUDIO_DEFAULT_VOICE_ID
#   Selecting a Fish Audio voice
FISH_AUDIO_DEFAULT_VOICE_ID=""

# FISH_AUDIO_MODEL
#   Fish Audio TTS model selection
FISH_AUDIO_MODEL=""

# FISH_AUDIO_VOICE_ID
#   Fallback Fish Audio reference/voice id when none is stored per-workspace
FISH_AUDIO_VOICE_ID=""

# FISH_AUDIO_AUDIO_FORMAT
#   Fish Audio output container (e.g. opus, mp3)
FISH_AUDIO_AUDIO_FORMAT=""

# FISH_AUDIO_LATENCY_MODE
#   Fish Audio latency profile
FISH_AUDIO_LATENCY_MODE=""

# --- TON Readiness ---
# TON_NETWORK
#   testnet/mainnet selection (defaults to testnet)
TON_NETWORK=""

# TONCENTER_API_KEY (SECRET)
#   Live TON Center probes
TONCENTER_API_KEY=""

# TONAPI_API_KEY (SECRET)
#   Live TONAPI probes
TONAPI_API_KEY=""

# TON_CONNECT_MANIFEST_URL
#   TON Connect wallet manifest
TON_CONNECT_MANIFEST_URL=""

# TON_ESCROW_ADDRESS
#   Escrow settlement address
TON_ESCROW_ADDRESS=""

# TON_CENTER_API_URL
#   TON Center RPC endpoint override
TON_CENTER_API_URL=""

# TONAPI_STATUS
#   Operator-declared TONAPI approval state
TONAPI_STATUS=""

# TON_ALLOW_CUSTOM_RPC
#   Permits a non-default RPC endpoint
TON_ALLOW_CUSTOM_RPC=""

# TON_TELEGRAM_APPS_CENTER_STATUS
#   Operator-declared Telegram Apps Center approval state
TON_TELEGRAM_APPS_CENTER_STATUS=""

# TON_FOUNDATION_STATUS
#   Operator-declared TON Foundation approval state
TON_FOUNDATION_STATUS=""

# TON_SECURITY_AUDIT_STATUS
#   Operator-declared security-audit state
TON_SECURITY_AUDIT_STATUS=""

# --- Provider Router (OpenAI) + Voice (TTS provider: OpenAI) ---
# OPENAI_API_KEY (SECRET)
#   Text generation via POST /api/execute-agent-task when the requested model routes to
#   OpenAI (lib/fabric/model-openai.ts, the Responses API), AND POST /api/voice/speak when
#   provider=openai. Both are real, billable api.openai.com calls.
OPENAI_API_KEY=""

# (OPENAI_MODEL / OPENAI_REVIEW_MODEL were removed: no model has a default any more — the
#  canonical router selects a route qualified for each task class.)

# OPENAI_BASE_URL
#   Overrides the OpenAI API base URL (an Azure/proxy/enterprise gateway, or a test double).
#   Unset uses https://api.openai.com/v1.
OPENAI_BASE_URL=""

# GEMINI_BASE_URL
#   Overrides the Gemini API base URL for the shared generation adapter (a gateway, or a test
#   double). Unset uses the SDK default. Its host is treated as a paid host by the network guard.
GEMINI_BASE_URL=""

# --- Model Registry (provider endpoints) ---
# SYNTHOS_PROVIDER_HOST_ALLOWLIST
#   Comma-separated extra hostnames a provider base-URL override (OPENAI_BASE_URL, GEMINI_BASE_URL,
#   ANTIGRAVITY_BASE_URL, or a manifest's own variable) may point at — e.g. an operator gateway.
#   Unset: only each provider manifest's approved hosts. An override to any other host FAILS CLOSED:
#   the provider reports NOT_CONFIGURED and no credential is sent.
SYNTHOS_PROVIDER_HOST_ALLOWLIST=""

# SYNTHOS_ALLOW_LOOPBACK_PROVIDERS
#   "true" allows a loopback provider endpoint (local gateway or test double) outside tests.
#   Ignored when NODE_ENV=production.
SYNTHOS_ALLOW_LOOPBACK_PROVIDERS=""

# NVIDIA_API_KEY (SECRET)
#   Credential for the NVIDIA NIM aggregator route. Unset: every NVIDIA route reports NOT_CONFIGURED.
#   Importing NVIDIA's model list never needs it — imports are metadata files an operator supplies.
NVIDIA_API_KEY=""

# SYNTHOS_LOCAL_RUNTIME_BASE_URL
#   Base URL of a self-hosted, OpenAI-compatible runtime on this machine (loopback only; no
#   credential is ever sent to it). Unset: http://localhost:11434/v1.
SYNTHOS_LOCAL_RUNTIME_BASE_URL=""

# SYNTHOS_ARTIFACT_VAULT_DIR
#   Absolute path of the artifact vault (task artifacts, receipts' evidence files). Unset: ./vault.
SYNTHOS_ARTIFACT_VAULT_DIR=""

# SYNTHOS_BACKUP_DIR
#   Absolute path where backup archives are written. Unset: ./backups.
SYNTHOS_BACKUP_DIR=""

# --- AEO GEO probe ---
# GEO_PROBE_MODEL
#   Overrides the Gemini model the AEO GEO probe asks. Every probe call goes through the spend
#   guard, which refuses a model that is not qualified and enabled in the model registry.
GEO_PROBE_MODEL=""

# --- AEO public visibility check (/check, unauthenticated) ---
# PUBLIC_CHECK_DAILY_CAP
#   Global daily cap (default 150). Each check makes spend-guarded model calls, refused unless paid
#   execution is ON and the probe model is qualified and enabled in the model registry.
PUBLIC_CHECK_DAILY_CAP=""

# PUBLIC_CHECK_CTA_URL
#   Call-to-action link shown after a public /check result.
PUBLIC_CHECK_CTA_URL=""

# --- Voice (TTS provider: ElevenLabs) ---
# ELEVENLABS_API_KEY (SECRET)
#   POST /api/voice/speak when provider=elevenlabs — a real, billable call. Not wired for text
#   generation.
ELEVENLABS_API_KEY=""

# --- Provider Status Reporting ---
# ANTHROPIC_API_KEY (SECRET)
#   Presence is REPORTED in provider status only — no execution mapping is wired in this build.
#   Setting it does not enable Claude.
ANTHROPIC_API_KEY=""

# NOUS_API_KEY (SECRET)
#   Presence is REPORTED in Hermes/Nous provider status only — no execution mapping is wired.
NOUS_API_KEY=""

# OLLAMA_BASE_URL
#   Presence is REPORTED in local-model status only — no execution mapping is wired.
OLLAMA_BASE_URL=""

# --- Telegram Notifications ---
# TELEGRAM_BOT_TOKEN (SECRET)
#   Reported as CONFIGURED/NOT_CONFIGURED in status surfaces
TELEGRAM_BOT_TOKEN=""

# --- AEO Audit (OpenSEO) ---
# OPENSEO_API_KEY (SECRET)
#   Live AEO/GEO audit data — a real, billable provider call
OPENSEO_API_KEY=""

# --- AEO Audit (SerpAPI) ---
# SERPAPI_KEY (SECRET)
#   Live SERP data — a real, billable provider call
SERPAPI_KEY=""

# --- AEO Audit (DataForSEO) ---
# DATAFORSEO_LOGIN (SECRET)
#   Live DataForSEO data — a real, billable provider call
DATAFORSEO_LOGIN=""

# --- AEO Audit (BrightData) ---
# BRIGHTDATA_API_KEY (SECRET)
#   Live BrightData retrieval — a real, billable provider call
BRIGHTDATA_API_KEY=""

# --- Repository Research ---
# GITHUB_TOKEN (SECRET)
#   Raises the GitHub Search API rate limit. Unset still works at the anonymous limit.
GITHUB_TOKEN=""

# GITHUB_API_BASE_URL
#   Override for GitHub Enterprise or a test double
GITHUB_API_BASE_URL=""

# --- Tool Pack 1 ---
# GITHUB_APPROVED_REPOS
#   The repository allowlist for the github.read_file and github.inspect tools.
#   Comma-separated "owner/name", or "owner/*" to approve one whole owner.
#   UNSET MEANS NO REPOSITORY IS APPROVED — both tools report NOT_CONFIGURED
#   rather than defaulting to all of GitHub. A bare "*" is deliberately not
#   honoured; "all of GitHub" is not a boundary.
#   github.search reads the public index and does NOT require this.
#   Example: GITHUB_APPROVED_REPOS="acme/widget,contoso/*"
GITHUB_APPROVED_REPOS=""

# SYNTHOS_REPO_ROOT
#   Base directory the files.read allowed roots (docs, vault, scripts) resolve
#   against. Defaults to the process working directory. Set only to relocate
#   the readable roots; the repository root itself is never an allowed root.
SYNTHOS_REPO_ROOT=""

# --- Public Assistant Address ---
# PUBLIC_BASE_URL
#   The https origin used to build the public assistant link and the embed snippet. Unset means
#   the address is inferred per-request from Host/X-Forwarded-Proto, which is correct only when
#   TRUST_PROXY_HOPS matches the real proxy depth.
PUBLIC_BASE_URL=""

# --- Server Host ---
# PORT
#   HTTP listen port (defaults to 3000)
PORT=""

# HOST
#   HTTP listen interface. Defaults to 0.0.0.0 because a container must be reachable from the
#   reverse proxy beside it (docker-compose.prod.yml). Set to 127.0.0.1 for a local always-on
#   service (the macOS LaunchAgent in docs/deploy/ALWAYS-ON-LOCAL-RUNTIME.md) so nothing on the
#   local network can reach the admin.
HOST=""
# SYNTHOS_BIND_HOST
#   Network interface the Admin binds to. Takes precedence over HOST. With neither set the
#   Admin binds 127.0.0.1 (loopback only), so a laptop never exposes the admin plane to its
#   LAN by default. The Dockerfile sets 0.0.0.0 explicitly, because a container must be
#   reachable from the reverse proxy beside it.
SYNTHOS_BIND_HOST=""

# TRUST_PROXY_HOPS
#   Correct client IP resolution (rate limiting) behind exactly N reverse proxies — unset means
#   trust none, Express default
TRUST_PROXY_HOPS=""

# --- Database ---
# SYNTHOS_DB_PATH
#   SQLite file location (defaults to ./data/synthos-admin.db)
SYNTHOS_DB_PATH=""

# --- Receipt Signing ---
# SYNTHOS_SIGNING_KEY_DIR
#   Ed25519 keypair storage location (defaults to ./data/keys, self-generates on first use)
SYNTHOS_SIGNING_KEY_DIR=""

# SYNTHOS_SIGNING_PRIVATE_KEY_PEM (SECRET)
#   Injecting a pre-provisioned signing key (e.g. from a secret manager) instead of
#   self-generating
SYNTHOS_SIGNING_PRIVATE_KEY_PEM=""

# SYNTHOS_SIGNING_PUBLIC_KEY_PEM
#   Paired with SYNTHOS_SIGNING_PRIVATE_KEY_PEM
SYNTHOS_SIGNING_PUBLIC_KEY_PEM=""

# SYNTHOS_APPROVAL_VERIFICATION
#   Enables verification.external_action: a synthetic EXTERNAL_ACTION that
#   exists only to prove the human-approval lifecycle end to end before a real
#   outbound tool (Gmail) ships. It passes the identical gate — Guardian, then
#   human approval, then single-use consumption — and its "external call" is a
#   bounded LOCAL contract double: no socket, no provider, no recipient.
#   Unset (the default) means the capability reports NOT_CONFIGURED.
SYNTHOS_APPROVAL_VERIFICATION=""

# --- Tool Pack 2: Gmail connector ---------------------------------------
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET (SECRET)
#   Identify the SynthOS application to Google. Required before any Gmail
#   account can be connected. Create an OAuth 2.0 "Web application" client in
#   Google Cloud Console with the Gmail API enabled, and request only:
#     https://www.googleapis.com/auth/gmail.readonly
#     https://www.googleapis.com/auth/gmail.compose
#     https://www.googleapis.com/auth/gmail.send
#   Deliberately NOT gmail.modify, gmail.settings.* or mail.google.com — the
#   tools read, draft and send; nothing they do needs to reconfigure a mailbox.
#   The refresh token from the OAuth exchange is stored encrypted, per
#   workspace, and is never returned by any route.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# GOOGLE_OAUTH_TOKEN_URL / GMAIL_API_BASE_URL
#   Test-double overrides, same convention as GITHUB_API_BASE_URL.
GOOGLE_OAUTH_TOKEN_URL=""
GMAIL_API_BASE_URL=""
