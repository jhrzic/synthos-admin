# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Fish Audio Credentials (Hanabi AI)
FISH_AUDIO_API_KEY=""
FISH_AUDIO_DEFAULT_VOICE_ID="7f92f8afb8ec43bf81429cc1c9199cb1"
FISH_AUDIO_VOICE_ID="7f92f8afb8ec43bf81429cc1c9199cb1"

# Voice Pipeline Configurations
FISH_AUDIO_WS_URL="wss://api.fish.audio/v1/tts/live"
FISH_AUDIO_LATENCY_MODE="low"
FISH_AUDIO_AUDIO_FORMAT="opus"
FISH_AUDIO_FALLBACK_LATENCY_MS=800

# Hermes Runtime Adapter (ADR-001)
HERMES_ADAPTER_BASE_URL=""
HERMES_ADAPTER_TOKEN=""

# OpenAI provider (PUSH 1). OPENAI_API_KEY now authorizes real, billable TEXT
# generation through the Execution Fabric (POST /api/execute-agent-task, when
# the requested model routes to OpenAI) as well as the pre-existing voice TTS
# route. Unset means the capability registry and the runtime status table both
# report NOT_CONFIGURED — never a fabricated AVAILABLE. OPENAI_MODEL overrides
# the default model id (OpenAI retires snapshots on a schedule, so this is a
# knob rather than a code edit); OPENAI_BASE_URL points at an Azure/proxy/
# enterprise gateway or a test double. See lib/fabric/model-openai.ts.
OPENAI_API_KEY=""
OPENAI_MODEL=""
# OPENAI_REVIEW_MODEL overrides the model the SynthOS Development Review Seat runs on. Kept
# separate from OPENAI_MODEL so raising the reasoning model does not also raise the cost of
# ordinary generation. Unset uses lib/model-router.ts DEFAULT_OPENAI_REVIEW_MODEL.
OPENAI_REVIEW_MODEL=""
OPENAI_BASE_URL=""

# Antigravity execution runtime (PUSH 1). An execution WORKER, never a control
# plane: SynthOS submits already-Guardian-checked instructions to Google's
# managed agent API and nothing it returns is trusted — every result still
# passes Aegis and the KIL gate before a receipt exists.
#
# ANTIGRAVITY_ENABLED is a real kill switch enforced in code, not a note: it
# must be exactly "true" or submission is refused outright, so holding a Gemini
# credential never silently grants the ability to run autonomous remote agents.
# ANTIGRAVITY_API_KEY is optional — unset falls back to the resolved Gemini
# credential, since it is the same Google endpoint and the same key type.
# See lib/antigravity-client.ts.
ANTIGRAVITY_ENABLED=""
ANTIGRAVITY_API_KEY=""
ANTIGRAVITY_AGENT=""
ANTIGRAVITY_BASE_URL=""

# MCP (Model Context Protocol) connectivity (Pass V / ADR-005)
# MCP_ALLOW_LOCAL_ENDPOINTS: escape hatch for local development only — with
# this unset, the MCP probe blocks loopback/private/link-local/metadata
# addresses by default. Never set true in production.
MCP_ALLOW_LOCAL_ENDPOINTS=""
# MCP_CREDENTIAL_ENCRYPTION_KEY: AES-256-GCM key (any length, sha256'd to
# 32 bytes) for encrypting MCP server bearer-token credentials at rest.
# Unset means credential storage is refused outright — never falls back to
# plaintext. See lib/mcp-client.ts and docs/adr-005-runtime-provider-boundaries.md.
MCP_CREDENTIAL_ENCRYPTION_KEY=""

# TON / Telegram product — none of these being unset is an error. Every
# readiness item defaults to NOT_CONFIGURED and stays there until a real
# value is set; a live probe still has to succeed before anything shows
# APPROVED. See lib/ton-readiness.ts / lib/ton-probe.ts.
TON_NETWORK="testnet"
TON_CONNECT_MANIFEST_URL=""
TON_CENTER_API_URL=""
TONCENTER_API_KEY=""
TONAPI_API_KEY=""
TONAPI_STATUS=""
TON_ESCROW_ADDRESS=""
TON_ALLOW_CUSTOM_RPC=""
TON_TELEGRAM_APPS_CENTER_STATUS=""
TON_FOUNDATION_STATUS=""
TON_SECURITY_AUDIT_STATUS=""

# Windmill external execution control plane (ADR-006). SynthOS remains the
# authority/verification/receipt layer; Windmill is only ever an external
# job runner it submits already-authorized work to. All three must be set
# for any real call to be attempted — unset means every route and the
# Master Admin runtime panel honestly report NOT_CONFIGURED, never a
# fabricated CONNECTED. No scheduler exists in SynthOS itself; scheduling,
# if any, stays entirely Windmill-side. See lib/windmill-client.ts.
WINDMILL_BASE_URL=""
WINDMILL_TOKEN=""
WINDMILL_WORKSPACE=""
