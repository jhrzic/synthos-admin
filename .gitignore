dist/
node_modules/
build/
coverage/
.DS_Store
*.log
*.mp4
.env*
!.env.example

# SynthOS Runtime & Database
data/*.db
data/*.db-*
data/keys/
data/runtime/
vault/Startup-Theses/Read-SynthOS-Admin-package-version.md

# SynthOS Backups (real database + vault snapshots — never committed)
backups/
/backups/**

# Any SQLite database, journal or archive anywhere in the tree is runtime
# state, never source. (An early dev database was committed on 2026-09-01
# and removed in 2bc5d79; these patterns stop it recurring.)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-*
*.bak
*.tar.gz
*.tgz

# Machine-local editor / agent configuration (per-developer, never shared)
.claude/
.vscode/

# Ad-hoc local screenshots
gh screens/

# Vault subtrees SynthOS WRITES AT RUNTIME.
# These are execution output, not source: agent-generated reports, conversation
# notes and per-workspace artifacts produced by whatever ran on this machine.
# Same reason Read-SynthOS-Admin-package-version.md above is ignored — committing
# them would put one machine's run history into every checkout, and the volume
# (2,491 files here) drowns real diffs.
vault/External-Executions/
vault/SynthOS/
vault/workspaces/
vault/Startup-Theses/Step1b-Live-Verification.md
